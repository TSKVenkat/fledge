# --- Required -----------------------------------------------------------------

# Encrypts secrets at rest and signs cookies. 32 bytes, base64. No default, on
# purpose: an instance that starts with a known key is not secured by it.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_KEY=

# The first administrator, created only when the database has no users at all.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Where this instance is reachable ------------------------------------------

# Where a BROWSER reaches the application. Not where the server listens.
PUBLIC_URL=http://localhost:8080

# Where a BROWSER reaches the sandbox. The compose stack publishes it on its own
# port for local use, and that is fine on one machine. On a network the sandbox
# MUST be a different HOST NAME, not just a port: cookies ignore ports, so a
# second port shares the application's cookies and is not an isolation boundary
# at all. See SECURITY.md.
SANDBOX_URL=http://localhost:8081
SANDBOX_PORT=8081

# --- Optional ------------------------------------------------------------------

WEB_PORT=8080
POSTGRES_PASSWORD=fledge

# Allow students to install packages from PyPI at runtime. Off by default: many
# school networks block it, and a half-working install is worse than a clear
# "not available here".
ALLOW_MICROPIP=false
