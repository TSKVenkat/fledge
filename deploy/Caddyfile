# The application and the sandbox are different origins, which is the security
# boundary; serving them from one Caddy keeps that boundary while needing only
# one certificate story.

{
	admin off
	auto_https off
}

# --- The application --------------------------------------------------------
:8080 {
	root * /srv

	# Isolation is a progressive enhancement: the runtime negotiates what it can
	# get. Granting it here means the editor runs at full fidelity, and the
	# degraded path stays something we test deliberately rather than fall into.
	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		Cross-Origin-Resource-Policy cross-origin
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}

	# The Python runtime is immutable and versioned by its path.
	@runtime path /pyodide/*
	header @runtime Cache-Control "public, max-age=31536000, immutable"

	handle /v1/* {
		reverse_proxy api:3000
	}
	handle /health {
		reverse_proxy api:3000
	}
	handle {
		try_files {path} /index.html
		file_server
	}
}

# --- The sandbox ------------------------------------------------------------
# A different host name, not a port: cookies ignore ports, so a second port
# would share the application's cookies and provide no isolation at all.
:8081 {
	root * /srv

	header {
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Embedder-Policy require-corp
		# Lets the application, which sets COEP, embed this frame.
		Cross-Origin-Resource-Policy cross-origin
		# Chromium-only, and free: it upgrades a third-party embed from a
		# terminate-only stop to a graceful one. Everywhere else it is ignored.
		Document-Isolation-Policy isolate-and-require-corp
		# We exist to be embedded, so X-Frame-Options is deliberately absent.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Content-Type-Options nosniff
		-Server
	}

	@runtime path /pyodide/*
	header @runtime Cache-Control "public, max-age=31536000, immutable"

	handle {
		try_files {path} /frame.html
		file_server
	}
}
