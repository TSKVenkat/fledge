{
  "name": "fledge",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @fledge/api dev",
    "dev:web": "pnpm --filter @fledge/web dev",
    "db:generate": "pnpm --filter @fledge/db generate",
    "db:migrate": "pnpm --filter @fledge/db migrate",
    "stack": "docker compose --env-file .env -f deploy/docker-compose.yml up -d --build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test:runtime": "node packages/runtime/test/run.mjs",
    "test:e2e": "node e2e/smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright": "1.62.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.69.0",
    "vitepress": "^1.6.4",
    "vitest": "^3.0.0"
  }
}
